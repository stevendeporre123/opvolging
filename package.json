{
  "name": "afspraken-commissies",
  "version": "1.0.0",
  "private": true,
  "description": "Opvolging van afspraken uit werknota's van de Gentse gemeenteraadscommissies",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply afspraken_commissies_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply afspraken_commissies_db --remote",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241224.0",
    "typescript": "^5.7.2",
    "wrangler": "^4.165.0"
  }
}
